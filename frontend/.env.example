# Optional: full API origin (no trailing slash). Leave unset in dev to use Vite proxy → http://localhost:5000
# VITE_API_URL=http://localhost:5000

# Optional: proxy target when VITE_API_URL is empty (default http://localhost:5000)
# VITE_API_PROXY_TARGET=http://localhost:5000

# Google OAuth Web client ID — also set the same value as GOOGLE_CLIENT_ID in backend/.env
# In Google Cloud Console → Credentials → your OAuth client → Authorized JavaScript origins:
#   http://localhost:5173   (and your production URL when you deploy)
VITE_GOOGLE_CLIENT_ID=
